# taskmanager-ui environment variables
# Copy to `.env` for local development.
#
# Note: Angular does not read `.env` at runtime — app-level config
# (API URLs, Keycloak client) belongs in src/environments/*.ts. Only
# variables consumed by the Node SSR server / build tooling go here.

# Port the SSR server listens on (see server.ts). Defaults to 4000.
PORT=4000
