# task-service environment variables
# Copy to `.env` for local development. Values shown are the local-dev defaults
# baked into app/config.py — override per environment.

# Service identifier used in logs / health endpoints.
SERVICE_NAME=task-service

# SQLAlchemy URL for the tasks Postgres database.
# Local dev points at the `tasks_db` created by scripts/init-multiple-dbs.sh
# inside the docker-compose `postgres` container.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tasks_db

# OIDC issuer URL of the Keycloak realm used to validate access tokens.
KEYCLOAK_ISSUER=http://localhost:8080/realms/taskmanager

# Expected `aud` claim on incoming JWTs.
KEYCLOAK_AUDIENCE=taskmanager-api

# JWKS endpoint used to fetch signing keys for JWT verification.
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/taskmanager/protocol/openid-connect/certs

# Pub/Sub topic that task lifecycle events (task.created / task.updated)
# are published to; consumed by the notification cloud function.
PUBSUB_TOPIC_TASKS_EVENTS=tasks-events

# CORS allow-list (JSON array). Local dev allows the Angular dev server.
CORS_ORIGINS=["http://localhost:4200"]
