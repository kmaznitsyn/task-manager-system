# notification cloud function environment variables
# Copy to `.env` for local development with `functions-framework`.
#
# main.py currently reads no env vars directly — the function is triggered by
# a Pub/Sub CloudEvent and the trigger wiring is configured at deploy time
# (gcloud / terraform), not via env vars. The variables below cover the
# integration points the function needs once TM-11 is implemented.

# GCP project that owns the Pub/Sub topic / subscription. Required by the
# functions-framework emulator when relaying Pub/Sub events locally.
GCP_PROJECT=taskmanager-local

# Pub/Sub topic this function subscribes to. Must match task-service's
# PUBSUB_TOPIC_TASKS_EVENTS.
PUBSUB_TOPIC=tasks-events

# Keycloak admin API — used to look up the recipient's email by `owner_sub`.
# The service-account client below needs the `view-users` role from
# `realm-management`.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=taskmanager
KEYCLOAK_CLIENT_ID=notification-fn
KEYCLOAK_CLIENT_SECRET=

# SendGrid API key used to send notification emails. Leave blank in local dev
# to fall back to log-only delivery.
SENDGRID_API_KEY=

# From-address used on outbound notification emails.
NOTIFICATION_FROM_EMAIL=no-reply@taskmanager.local

# Python log level for the function runtime.
LOG_LEVEL=INFO
